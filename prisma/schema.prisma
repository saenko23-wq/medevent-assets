generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          String    @default("viewer")
  accounts      Account[]
  sessions      Session[]
  reports       Report[]  @relation("ReportAssignee")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Client {
  id              String           @id @default(cuid())
  company         String
  directions      String
  notes           String?
  productManagers ProductManager[]
  contacts        Contact[]
  deals           Deal[]
  eventSlots      EventSlot[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model ProductManager {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Contact {
  id        String   @id @default(cuid())
  name      String
  position  String?
  email     String?
  phone     String?
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Speaker {
  id             String         @id @default(cuid())
  fullName       String
  phone          String
  specialization String
  eventSpeakers  EventSpeaker[]
  eventSlots     EventSlot[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Event {
  id             String         @id @default(cuid())
  title          String
  eventCode      String?
  pageUrl        String?
  programDraftUrl String?
  youtubeDay1Url String?
  youtubeDay2Url String?
  startDate      DateTime
  endDate        DateTime
  format         String
  deliveryFormat String        @default("ONLINE")
  formatDetails  String?
  therapeuticDirection String?
  bprPoints      Int?
  projectManager String?
  talkCount      Int            @default(0)
  nonPharmaCount Int            @default(0)
  slotPrice      String?
  plannedBudget  Decimal
  actualBudget   Decimal
  averageCheck   Decimal        @default(0)
  totalSpeakerHonorarium Decimal @default(0)
  status         String
  eventSpeakers  EventSpeaker[]
  slots          EventSlot[]
  tasks          OperationTask[]
  documents      EventDocument[]
  deals          Deal[]
  reports        Report[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model EventSpeaker {
  eventId   String
  speakerId String
  role      String?
  event     Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  speaker   Speaker @relation(fields: [speakerId], references: [id], onDelete: Cascade)

  @@id([eventId, speakerId])
}

model Deal {
  id            String      @id @default(cuid())
  clientId      String
  eventId       String
  package       String
  amount        Decimal
  planAmount    Decimal     @default(0)
  factAmount    Decimal     @default(0)
  paidAmount    Decimal     @default(0)
  productManager String?
  manager       String?
  status        String
  paymentStatus String
  paymentDeadline DateTime?
  reportDeadline DateTime?
  comment       String?
  archived      Boolean     @default(false)
  client        Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  event         Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  payments      Payment[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model EventSlot {
  id                       String   @id @default(cuid())
  eventId                  String
  rowNumber                Int?
  rowType                  String
  rowTypeNormalized        String   @default("PARTNER")
  clientId                 String?
  productManager           String?
  manager                  String?
  salesStatus              String
  package                  String
  price                    Decimal?
  crmSource                String?
  speakerId                String?
  speakerName              String?
  moderatorName            String?
  participationFormat      String?
  speakerParticipationMode String?
  contact                  String?
  speakerHonorarium        Decimal?
  honorariumPayer          String?
  honorariumPaymentStatus  String?
  talkTitle                String?
  brandTopic               String?
  studioRecord             String?
  duration                 String?
  direction                String?
  draftSent                Boolean  @default(false)
  documentsSent            Boolean  @default(false)
  reportSent               Boolean  @default(false)
  programComment           String?
  managerComment           String?
  technicalKey             String?
  missingInputs            String?
  crmUrl                   String?
  tasks                    OperationTask[]
  event                    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  client                   Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  speaker                  Speaker? @relation(fields: [speakerId], references: [id], onDelete: SetNull)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model OperationTask {
  id          String          @id @default(cuid())
  eventId     String
  slotId      String?
  type        String
  process     String          @default("project")
  group       String?
  title       String
  description String?
  deadline    DateTime?
  deadlineState String        @default("no_date")
  factDate    DateTime?
  assignee    String?
  status      String @default("not_started")
  ownerRole   String?
  executorUserId String?
  controllerUserId String?
  link        String?
  blocker     String?
  nextStep    String?
  comment     String?
  manualMode  Boolean         @default(false)
  source      String          @default("manual")
  packageCode String?
  nextOwner   String?
  event       Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  slot        EventSlot?      @relation(fields: [slotId], references: [id], onDelete: SetNull)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model EventDocument {
  id        String   @id @default(cuid())
  eventId   String
  title     String
  url       String
  type      String
  owner     String?
  notes     String?
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ReferenceCategory {
  id        String          @id @default(cuid())
  name      String          @unique
  items     ReferenceItem[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model ReferenceItem {
  id         String            @id @default(cuid())
  categoryId String
  value      String
  notes      String?
  isActive   Boolean           @default(true)
  category   ReferenceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@unique([categoryId, value])
}

model ParticipationPackage {
  id          String           @id @default(cuid())
  name        String           @unique
  price       Decimal
  format      String
  duration    String
  description String?
  features    PackageFeature[]
  serviceTemplates PackageServiceTemplate[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model PackageFeature {
  id        String               @id @default(cuid())
  packageId String
  name      String
  value     String
  package   ParticipationPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  createdAt DateTime             @default(now())

  @@unique([packageId, name])
}

model PackageServiceTemplate {
  id               String   @id @default(cuid())
  packageId        String
  packageCode      String
  serviceCode      String
  title            String
  process          String
  defaultOwnerRole String
  requiredInputs   String?
  deadlineRule     String?
  autoDoneCondition String?
  isRequired       Boolean  @default(true)
  package          ParticipationPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())

  @@unique([packageCode, serviceCode])
}

model Report {
  id         String       @id @default(cuid())
  title      String
  deadline   DateTime
  status     String @default("not_started")
  eventId    String
  assigneeId String
  event      Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  assignee   User         @relation("ReportAssignee", fields: [assigneeId], references: [id])
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

model ImportedSheet {
  id          String        @id
  name        String        @unique
  rowCount    Int
  columnCount Int
  rows        ImportedRow[]
  createdAt   DateTime      @default(now())
}

model ImportedRow {
  id        String        @id
  sheetId   String
  rowNumber Int
  data      Json
  sheet     ImportedSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([sheetId, rowNumber])
}

model Payment {
  id         String        @id @default(cuid())
  dealId     String
  status     String
  dueDate    DateTime
  paidAt     DateTime?
  amount     Decimal
  actualPaid Decimal       @default(0)
  deal       Deal          @relation(fields: [dealId], references: [id], onDelete: Cascade)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}
